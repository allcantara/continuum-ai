{
  "name": "continuum-ai",
  "version": "0.1.17",
  "description": "Persist and reuse work context across chats, projects, and tools via MCP and CLI",
  "author": "Bruno Vinicius Souza Alcantara",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allcantara/continuum-ai.git"
  },
  "bugs": {
    "url": "https://github.com/allcantara/continuum-ai/issues"
  },
  "homepage": "https://github.com/allcantara/continuum-ai#readme",
  "bin": {
    "continuum": "dist/presentation/cli/cli.js",
    "continuum-mcp": "dist/presentation/mcp/server.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/presentation/mcp/server.ts",
    "start": "node dist/presentation/mcp/server.js",
    "cli": "tsx src/presentation/cli/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "keywords": [
    "mcp",
    "context",
    "memory",
    "ai",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "esbuild": "^0.28.2",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
