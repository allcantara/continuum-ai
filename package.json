{
  "name": "continuum",
  "version": "0.1.0",
  "description": "Persist and reuse work context across chats, projects, and tools via MCP and CLI",
  "type": "module",
  "bin": {
    "continuum": "./dist/presentation/cli/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/presentation/mcp/server.ts",
    "start": "node dist/presentation/mcp/server.js",
    "cli": "tsx src/presentation/cli/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "keywords": [
    "mcp",
    "context",
    "memory",
    "ai",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
